# Il modo più semplice è eseguire ./setup.sh: crea questo file con le password,
# docker-compose.yml dal template scelto e il primo utente.
# In alternativa: copia questo file in .env, copia uno dei template _deploy_*_example.yml
# in docker-compose.yml, avvia e crea un utente con ./manage-users.sh create

# Nome dell'istanza: prefisso di container, immagini e reti (minuscole, cifre, trattini).
# Per più studi sullo stesso server usa una cartella e un nome diversi per ciascuno.
INSTANCE=studio-odontoiatrico

# Password del database (obbligatoria, usa una stringa lunga e casuale)
POSTGRES_PASSWORD=cambia-questa-password

# Chiave per firmare i cookie di sessione (opzionale: se vuota ne viene generata una
# e salvata nel database)
SESSION_SECRET=

# Porta HTTP pubblicata sull'host (usata solo con _deploy_network_example.yml)
HTTP_PORT=80

# Fuso orario (determina il "giorno di oggi")
TZ=Europe/Rome
