# Il modo più semplice per creare il file .env è eseguire ./setup.sh
# (genera le password in automatico). In alternativa copia questo file in .env
# e personalizza i valori.

# Password del database (obbligatoria, usa una stringa lunga e casuale)
POSTGRES_PASSWORD=cambia-questa-password

# Password per accedere all'applicazione dal browser.
# Lasciala vuota SOLO se l'app non è raggiungibile da Internet.
APP_PASSWORD=

# Chiave per firmare i cookie di sessione (opzionale, stringa casuale)
SESSION_SECRET=

# Porta HTTP pubblicata sull'host
HTTP_PORT=80

# Fuso orario (determina il "giorno di oggi")
TZ=Europe/Rome
